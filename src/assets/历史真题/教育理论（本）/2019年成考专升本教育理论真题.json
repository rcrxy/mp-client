": 0, "e": "", "econtent": "", "exerId": 867808, "exerType": "历年真题", "f": "", "freqCoeff": 0, "g": "", "h": "", "htmlTag": false, "jcontent": "", "keyType": "单选", "matRef": "", "myCollectionId": 0, "newKeyType": 1, "optNum": 4, "pptId": 0, "prName": "2019年成考专升本教育理论真题", "pracTimesAmount": 0, "questionType": 1, "reviewExerGroupRecId": 0, "rightKey": "D", "rightRate": 0, "score": 2, "scoreLess": 0, "scoreRules": 0, "scoringMethod": 1, "simExamScore": 2, "source": "2019年", "starCount": 0, "title": "现代教学论认为,教学方法是指（）", "topicType": "单选题", "ueId": 867808, "umcId": 13746071, "userKey": "", "userKeyImg1": "", "userKeyImg2": "", "userKeyImg3": "", "userScore": 0, "wcId": 11}, {"a": "集体教育原则", "accuracyAmount": 0, "analyze": "本题考查德育原则。实施长善救失德育原则的基本要求包括:(1)师要用一分为二的观点进行全面分析,客观评价学生的优点和不足;(2)教师要有意识地创造条件,学生思想中的消极因素转化为积极因素;(3)教师要提高学生的自我认识、自我评价能力,启发他们自觉思考克服缺点,发扬优点。题干中美术老师为不善绘画的小明的进步而高兴,并提出“多多练习”的要求,鼓励小明“画出美丽的图画”,正所谓“长其善而救其失”。", "b": "长善救失原则", "c": "理论联系实际原则", "catId": 0, "correct": false, "correctTimesAmount": 0, "d": "疏导原则", "diffCoeff": 0, "e": "", "econtent": "", "exerId": 867809, "exerType": "历年真题", "f": "", "freqCoeff": 0, "g": "", "h": "", "htmlTag": false, "jcontent": "", "keyType": "单选", "matRef": "", "myCollectionId": 0, "newKeyType": 1, "optNum": 4, "pptId": 0, "prName": "2019年成考专升本教育理论真题", "pracTimesAmount": 0, "questionType": 1, "reviewExerGroupRecId": 0, "rightKey": "B", "rightRate": 0, "score": 2, "scoreLess": 0, "scoreRules": 0, "scoringMethod": 1, "simExamScore": 2, "source": "2019年", "starCount": 0, "title": "小明不善绘画,交给美术老师的作业是一些杂乱无章的涂鸦,他很忐忑地等待老师的批评。老师看后举着这幅作品说:“我数过了,这位同学的绘画中共用了24种颜色,是我们班使用颜色最多的,我为他的进步而高兴。”接着又亲切地对小明说:“你能用这么多颜色,如果平时再多多练习,也一定能通过这些颜色的搭配画出美丽的图画!”这个老师的做法体现了哪一德育原则的要求?（）", "topicType": "单选题", "ueId": 867809, "umcId": 13746071, "userKey": "", "userKeyImg1": "", "userKeyImg2": "", "userKeyImg3": "", "userScore": 0, "wcId": 12}, {"a": "正确", "accuracyAmount": 0, "analyze": "讲授法是教师运用口头语言系统地向学生传授知识的一种方法,它有利于学生系统地学习掌握科学知识、发展智力、接受思想品德教育,但学生的主动性、积极性不易发挥。注人式是一种“填鸭式”的教学