false, "correctTimesAmount": 0, "d": "", "diffCoeff": 0, "e": "", "econtent": "", "exerId": 834586, "exerType": "历年试题", "f": "", "freqCoeff": 0, "g": "", "h": "", "htmlTag": true, "jcontent": "<p><span style=\"font-size: 14px; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;;\">(1)由</span><img src=\"http://ppt.beegoedu.com/Upload/image/20200324/6372066659076408559988497.jpg\" title=\"clip_image002.jpg\"/><span style=\"font-size: 14px; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;;\">得C=45°</span></p><p><span style=\"font-size: 14px; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;;\">故A=180°-75°-45=60°</span></p><p><span style=\"font-size: 14px; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;;\">因此cosA=cos60°</span></p><p><span style=\"font-size: 14px; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;;\">(Ⅱ)由正弦定理=BC/sinA=AB/sinC,故AB=BCsinC/sinA</span><img src=\"http://ppt.beegoedu.com/Upload/image/20200324/6372066659089885632244393.jpg\" title=\"clip_image004.jpg\"/><img src=\"http://ppt.beegoedu.com/Upload/image/20200324/6372066659106390172431362.jpg\" title=\"clip_image006.jpg\"/></p><p><span style=\"font-size: 14px; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;;\">&nbsp;</span></p><p><br/></p>", "keyType": "解答题", "matRef": "", "myCollectionId": 0, "newKeyType": 3, "optNum": 1, "pptId": 0, "prName": "2019年成考高起专数学真题", "pracTimesAmount": 0, "questionType": 3, "reviewExerGroupRecId": 0, "rightKey": "", "rightRate": 0, "score": 12, "scoreLess": 0, "scoreRules": 0, "scoringMethod": 1, "simExamScore": 12, "source": "2019", "starCount": 0, "title": "在△ABC中,已知B=75°,<img src=\"http://ppt.beegoedu.com/CourseIMG/H011201/2020TKZT/J5.png\" />(I)求cosA;(Ⅱ)若BC=3,求AB.", "topicType": "主观题", "ueId": 834586, "umcId": 13769404, "userKey": "", "userKeyImg1": "", "userKeyImg2": "", "userKeyImg3": "", "userScore": 0, "wcId": 23}, {"a": "", "accuracyAmount": 0, "analyze": "", "b": "", "c": "", "catId": 0, "correct": false, "correctTimesAmount": 0, "d": "", "diffCoeff": 0, "e": "", "econtent": "", "exerId": 834587, "exerType": "历年试题", "f": "", "freqCoeff": 0, "g": "", "h": "", "htmlTag": true, "jcontent": "<p><span style=\"font-size: 14px; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;;\">(1)⊙M可化为标准方程</span><img src=\"http://ppt.beegoedu.com/Upload/image/20200324/6372066664006675999994920.jpg\" title=\"clip_image002.jpg\"/></p><p><span style=\"font-size: 14px; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;;\">其圆心M点的坐标为(1,-1),半径为</span><img src=\"http://ppt.beegoedu.com/Upload/image/20200324/6372066664023375854007478.jpg\" title=\"clip_image004.jpg\"/></p><p><span style=\"font-size: 14px; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;;\">⊙O的圆心为坐标原点,</span></p><p><span style=\"font-size: 14px; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;;\">可设其标准方程为x<sup>2</sup>+y<sup>2</sup>=r<sub>2</sub><sup>2</sup>,</span></p><p><span style=\"font-size: 14px; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;;\">⊙O过M点,故有</span><img src=\"http://ppt.beegoedu.com/Upload/image/20200324/6372066664039978052721864.jpg\" title=\"clip_image006.jpg\"/></p><p><span style=\"font-size: 14px; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;;\">因此⊙O的标准方程为x<sup>2</sup>+y<sup>2</sup>=2.</span></p><p><span style=\"font-size: 14px; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;;\">&nbsp;(Ⅱ)点M到直线的距离</span><img src=\"http://ppt.beegoedu.com/Upload/image/20200324/6372066664056775571436251.jpg\" title=\"clip_image008.jpg\"/></p><p><span style=\"font-size: 14px; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;;\">点O到直线的距离</span><img src=\"http://ppt.beegoedu.com/Upload/image/20200324/6372066664073377775921392.jpg\" title=\"clip_image010.jpg\"/></p><p><span style=\"font-size: 14px; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;;\">故⊙M和⊙O的圆心到直线x-y+2=0的距离均等于其半径,</span></p><p><span style=\"font-size: 14px; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;;\">即直线x-y+2=0与⊙M和⊙O都相切</span></p><p><span style=\"font-size: 14px; font-family: 微软雅黑, &quot;Microsoft YaHei&quot;;\">&nbsp;</span></p><p><br/></p>", "keyT