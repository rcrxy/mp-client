ype": "历年真题", "f": "", "freqCoeff": 0, "g": "", "h": "", "htmlTag": false, "jcontent": "", "keyType": "单选", "matRef": "", "myCollectionId": 0, "newKeyType": 1, "optNum": 4, "pptId": 0, "prName": "2018年成考专升本民法真题", "pracTimesAmount": 121, "questionType": 1, "reviewExerGroupRecId": 0, "rightKey": "A", "rightRate": 0, "score": 2, "scoreLess": 0, "scoreRules": 0, "scoringMethod": 1, "simExamScore": 2, "source": "2018年", "starCount": 0, "title": "二人以上共同实施侵权行为致人损害的，应当承担（）。", "topicType": "单选题", "ueId": 464297, "umcId": 13731464, "userKey": "", "userKeyImg1": "", "userKeyImg2": "", "userKeyImg3": "", "userScore": 0, "wcId": 34}, {"a": "建筑物倒塌致人损害责任", "accuracyAmount": 0, "analyze": "本题考查了高度危险责任的知识点。《侵权责任法》第72条规定，占有或者使用易燃、易爆、刷毒、放射性等高度危险物造成他人损害的，占有人或者使用人应当承担侵权责任，但能够证明损害是因受害人故意或者不可抗力造成的，不承担责任。被侵权人对损害的发生有重大过失的，可以减轻占有人或者使用人的责任。", "b": "啤酒瓶爆炸致人损害责任", "c": "剧毒物品泄漏致人损害责任", "catId": 0, "correct": false, "correctTimesAmount": 85, "d": "烈性犬咬人致人损害责任", "diffCoeff": 0, "e": "", "econtent": "", "exerId": 464298, "exerType": "历年真题", "f": "", "freqCoeff": 0, "g": "", "h": "", "htmlTag": false, "jcontent": "", "keyType": "单选", "matRef": "", "myCollectionId": 0, "newKeyType": 1, "optNum": 4, "pptId": 0, "prName": "2018年成考专升本民法真题", "pracTimesAmount": 122, "questionType": 1, "reviewExerGroupRecId": 0, "rightKey": "C", "rightRate": 0, "score": 2, "scoreLess": 0, "scoreRules": 0, "scoringMethod": 1, "simExamScore": 2, "source": "2018年", "starCount": 0, "title": "下列选项中，属于《侵权责任法》上高度危险责任的是（）。", "topicType": "单选题", "ueId": 464298, "umcId": 13731464, "userKey": "", "userKeyImg1": "", "userKeyImg2": "", "userKeyImg3": "", "userScore": 0, "wcId": 35}, {"a": "", "accuracyAmount": 0, "analyze": "（1）父母对子女有抚养教育的义务；\n（2）父母对未成年子女有管教、保护的义务；\n（3）子女对父母有赡养扶助的义务；\n（4）父母和子女有相互继承遗产的权利。\n", "b": "", "c": "", "catId": 0, "correct": false, "correctTimesAmount": 9, "d": "", "diffCoeff": 0, "e": "", "econtent": "", "exerId": 464299, "exerType": "历年真题", "f": "", "freqCoeff": 0, "g": "", "h": "", "htmlTag": false, "jcontent