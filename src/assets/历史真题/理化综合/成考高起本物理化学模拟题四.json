MG/H011701/2021TKZT/B319.png' />由此可知,Z的原子序数比X、Y的原子序数小。又知,X、Y为同周期阳离子,其半径变化规律为左边元素的半径大于右边元素,所以Y的半径\n小,X半径大,即X的原子序数小,Y的原子序数大。原子序数由小到大的顺序为:Z、X、Y", "b": "Y、Z、X", "c": "Y、X、Z", "catId": 0, "correct": false, "correctTimesAmount": 0, "d": "Z、X、Y", "diffCoeff": 1, "e": "", "econtent": "", "exerId": 2506154, "exerType": "章节题", "f": "", "freqCoeff": 1, "g": "", "h": "", "htmlTag": true, "jcontent": "", "keyType": "单选", "matRef": "", "myCollectionId": 0, "newKeyType": 1, "optNum": 4, "pptId": 0, "prName": "成考高起本物理化学模拟题四", "pracTimesAmount": 0, "questionType": 1, "reviewExerGroupRecId": 0, "rightKey": "D", "rightRate": 0, "score": 4, "scoreLess": 0, "scoreRules": 0, "scoringMethod": 1, "simExamScore": 4, "source": "化学章节题", "starCount": 0, "title": "元素X、Y、Z的原子序数都小于18。X的阳离子、Y的阳离子和Z的阴离子都具有相同的电子层结构,Y的阳离子半径小于X的阳离子半径则元素X、Y、Z的原子序数从小到大的顺序依次为()", "topicType": "单选题", "ueId": 2506154, "umcId": 14407089, "userKey": "", "userKeyImg1": "", "userKeyImg2": "", "userKeyImg3": "", "userScore": 0, "wcId": 15}, {"a": "", "accuracyAmount": 0, "analyze": "<img src='http://ppt.beegoedu.com/CourseIMG/H011701/2021TKZT/S159.png' />", "b": "", "c": "", "catId": 0, "correct": false, "correctTimesAmount": 0, "d": "", "diffCoeff": 1, "e": "", "econtent": "", "exerId": 2506155, "exerType": "章节题", "f": "", "freqCoeff": 1, "g": "", "h": "", "htmlTag": true, "jcontent": "", "keyType": "填空题", "matRef": "", "myCollectionId": 0, "newKeyType": 3, "optNum": 1, "pptId": 0, "prName": "成考高起本物理化学模拟题四", "pracTimesAmount": 0, "questionType": 3, "reviewExerGroupRecId": 0, "rightKey": "", "rightRate": 0, "score": 6, "scoreLess": 0, "scoreRules": 0, "scoringMethod": 1, "simExamScore": 6, "source": "物理章节题", "starCount": 0, "title": "<img src='http://ppt.beegoedu.com/CourseIMG/H011701/2021TKZT/S141.png' />", "topicType": "主观题", "ueId": 2506155, "umcId": 14407089, "userKey": "", "userKeyImg1": "", "userKeyImg2": "", "userKeyImg3": "", "userScore": 0, "wcId": 16}, {"a": "", "accuracyAmount": 0, "analyze": "<img src='http://ppt.be