me": "2020年成考专升本生态学基础真题", "pracTimesAmount": 0, "questionType": 3, "reviewExerGroupRecId": 0, "rightKey": "", "rightRate": 0, "score": 10, "scoreLess": 0, "scoreRules": 0, "scoringMethod": 1, "simExamScore": 10, "source": "2020", "starCount": 0, "title": "什么是生活型?饶基耶尔(Raunkiaer)提出的植物生活型分为哪几类?", "topicType": "主观题", "ueId": 2120816, "umcId": 15970027, "userKey": "", "userKeyImg1": "", "userKeyImg2": "", "userKeyImg3": "", "userScore": 0, "wcId": 53}, {"a": "", "accuracyAmount": 0, "analyze": "(1)生产者(如绿色植物)利用太阳能将简单的无机物合成为有机物,成为生态系统有机物的来源。<br>(2)消费者利用生产者生的有机物进行次级生产,形成自身的物质。<br>(3)生产者和消费者也通过自身的呼吸作用，将有机物分解为无机物;分解者将生产者和消费者的有机残体逐斩降解为无机物;这些无机物释放到环境中,被生产者利用。<br>(4)生产者、消费者和分解者的共同作用使得物质循环能够不断进行,其中生产者和分解者的作用是必不可少的。", "b": "", "c": "", "catId": 0, "correct": false, "correctTimesAmount": 0, "d": "", "diffCoeff": 1, "e": "", "econtent": "", "exerId": 2120817, "exerType": "历年真题", "f": "", "freqCoeff": 1, "g": "", "h": "", "htmlTag": true, "jcontent": "", "keyType": "论述题", "matRef": "", "myCollectionId": 0, "newKeyType": 3, "optNum": 1, "pptId": 0, "prName": "2020年成考专升本生态学基础真题", "pracTimesAmount": 0, "questionType": 3, "reviewExerGroupRecId": 0, "rightKey": "", "rightRate": 0, "score": 20, "scoreLess": 0, "scoreRules": 0, "scoringMethod": 1, "simExamScore": 20, "source": "2020", "starCount": 0, "title": "论述生态系统的生产者、消费者和分解者在物质循环中的作用。", "topicType": "主观题", "ueId": 2120817, "umcId": 15970027, "userKey": "", "userKeyImg1": "", "userKeyImg2": "", "userKeyImg3": "", "userScore": 0, "wcId": 54}], "SimExamStore": {"ExerNum": 54, "CourseId": "H012701", "ExamTime": 150, "ExerSortType": 1, "ScoringMethod": 1, "TotalScore": 150, "SimType": "历年真题", "ExamName": "2020年成考专升本生态学基础真题"}, "simId": 17052}