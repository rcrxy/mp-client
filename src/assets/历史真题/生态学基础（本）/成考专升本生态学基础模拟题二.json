": 3, "optNum": 1, "pptId": 0, "prName": "成考专升本生态学基础模拟题二", "pracTimesAmount": 0, "questionType": 3, "reviewExerGroupRecId": 0, "rightKey": "", "rightRate": 0, "score": 10, "scoreLess": 0, "scoreRules": 0, "scoringMethod": 1, "simExamScore": 10, "source": "模拟题二", "starCount": 0, "title": "年龄金字塔有几种类型，各具什么特点？", "topicType": "主观题", "ueId": 2748349, "umcId": 15970027, "userKey": "", "userKeyImg1": "", "userKeyImg2": "", "userKeyImg3": "", "userScore": 0, "wcId": 35}, {"a": "", "accuracyAmount": 0, "analyze": "(1)食物链，是指在生态系统中生物之间通过吃与被吃关系联结起来的链索结构。<br>(2)食物网，是指一种消费者同时取食多种食物，而同一食物又可被多种消费者取食，于是形成生态系统内的多条食物链之间纵横交错、相互联结，从而构成网状结构。", "b": "", "c": "", "catId": 0, "correct": false, "correctTimesAmount": 0, "d": "", "diffCoeff": 1, "e": "", "econtent": "", "exerId": 2748350, "exerType": "模拟题", "f": "", "freqCoeff": 1, "g": "", "h": "", "htmlTag": true, "jcontent": "", "keyType": "简答题", "matRef": "", "myCollectionId": 0, "newKeyType": 3, "optNum": 1, "pptId": 0, "prName": "成考专升本生态学基础模拟题二", "pracTimesAmount": 0, "questionType": 3, "reviewExerGroupRecId": 0, "rightKey": "", "rightRate": 0, "score": 10, "scoreLess": 0, "scoreRules": 0, "scoringMethod": 1, "simExamScore": 10, "source": "模拟题二", "starCount": 0, "title": "什么是食物链、食物网？", "topicType": "主观题", "ueId": 2748350, "umcId": 15970027, "userKey": "", "userKeyImg1": "", "userKeyImg2": "", "userKeyImg3": "", "userScore": 0, "wcId": 36}, {"a": "", "accuracyAmount": 0, "analyze": "(1)人口数量的激增。<br>(2)数量增长不平衡。<br>(3)人口老龄化。<br>(4)性别比例不协调。<br> (5)人口城市化。<br>(6)人口健康状况下降。", "b": "", "c": "", "catId": 0, "correct": false, "correctTimesAmount": 0, "d": "", "diffCoeff": 1, "e": "", "econtent": "", "exerId": 2748351, "exerType": "模拟题", "f": "", "freqCoeff": 1, "g": "", "h": "", "htmlTag": true, "jcontent": "", "keyType": "简答题", "matRef": "", "myCollectionId": 0, "newKeyType": 3, "optNum": 1, "pptId": 0, "prName": "成考专升本生态学基础模拟题二", "pracTimesAmount": 0, "questionType": 3, "reviewExerGroupRecId": 0, "rightKey": "", "rightRate": 0, "score": 10, "scoreLess": 0, "scoreRules": 0, "scoringMethod": 1, "simExamScore": 10, "source": "模拟题二", "starCount": 0, "title": "简述人口问题的主要表现。（列举出5点即可）", "topicType": "主观题", "ueId": 2748351, "umcId": 15970027, "userKey": "", "userKeyImg1": "", "userKeyImg2": "", "userKeyImg3": "", "userScore": 0, "wcId": 37}, {"a": "", "accuracyAmount": 0, "analyze": "陆地生物群落地带性分布规律有水平地带性和垂直地带性。<br>(1)水平地带性可分为以下两类：<br>①纬向地带性：由于热量带沿纬度变化而变化，导致群落类型也随纬度变化依次更替，如亚洲大陆东岸，从赤道向北极依次是热带雨林一常绿阔叶林一落叶阔叶林一北方针叶林一苔原。<br>②经向地带性：由于降水自沿海向内陆依次减少导致群落类型沿经度方向依次更替，如亚洲温带大陆东岸，由沿海向内陆依次是森林一草原一荒漠。<br>(2)垂直地带性：由于山地随海拔升高，温度和降水依次变化，从而导致群落类型自下而上依次更替，如马来西亚的基那巴卢山，从下向上依次是山地雨林一山地常绿阔叶林一山地落叶阔叶林一山地针叶林一高山灌丛。", "b": "", "c": "", "catId": 0, "correct": false, "correctTimesAmount": 0, "d": "", "diffCoeff": 1, "e": "", "econtent": "", "exerId": 2748352, "exerType": "模拟题", "f": "", "freqCoeff": 1, "g": "", "h": "", "htmlTag": true, "jcontent": "", "keyType": "论述题", "matRef": "", "myCollectionId": 0, "newKeyType": 3, "optNum": 1, "pptId": 0, "prName": "成考专升本生态学基础模拟题二", "pracTimesAmount": 0, "questionType": 3, "reviewExerGroupRecId": 0, "rightKey": "", "rightRate": 0, "score": 20, "scoreLess": 0, "scoreRules": 0, "scoringMethod": 1, "simExamScore": 20, "source": "模拟题二", "starCount": 0, "title": "论述陆地生物群落地带性分布规律。", "topicType": "主观题", "ueId": 2748352, "umcId": 15970027, "userKey": "", "userKeyImg1": "", "userKeyImg2": "", "userKeyImg3": "", "userScore": 0, "wcId": 38}], "SimExamStore": {"ExerNum": 38, "CourseId": "H012701", "ExamTime": 150, "ExerSortType": 1, "ScoringMethod": 1, "TotalScore": 150, "SimType": "模拟题", "ExamName": "成考专升本生态学基础模拟题二"}, "simId": 21750}