*=Ae<sup>x</sup>，将y*代入y″-2 y′+2y=2e<sup>2</sup>，得A=2，因此此方程的通解为y=C<sub>1</sub>e<sup>x</sup>cosx+C<sub>2</sub>e<sup>x</sup>sinx+2e<sup>x</sup>.\n", "b": "", "c": "", "catId": 0, "correct": false, "correctTimesAmount": 0, "d": "", "diffCoeff": 1, "e": "", "econtent": "", "exerId": 1936396, "exerType": "同步练习", "f": "", "freqCoeff": 1, "g": "", "h": "", "htmlTag": true, "jcontent": "", "keyType": "解答题", "matRef": "", "myCollectionId": 0, "newKeyType": 3, "optNum": 1, "pptId": 0, "prName": "成教专升本高等数学（一）模拟题五", "pracTimesAmount": 0, "questionType": 3, "reviewExerGroupRecId": 0, "rightKey": "", "rightRate": 0, "score": 10, "scoreLess": 0, "scoreRules": 0, "scoringMethod": 1, "simExamScore": 10, "source": "考纲解读", "starCount": 0, "title": "求下列微分方程的通解。\n<br>(1)y″-8y′+7y=14  \n<br>(2)y″-y=e<sup>x</sup>     \n<br>(3)y″-4y′+4y=x<sup>2</sup>   \n<br>(4)y″-2y′+2y=2e<sup>x</sup>\n", "topicType": "主观题", "ueId": 1936396, "umcId": 16785272, "userKey": "", "userKeyImg1": "", "userKeyImg2": "", "userKeyImg3": "", "userScore": 0, "wcId": 28}], "SimExamStore": {"ExerNum": 28, "CourseId": "H012301", "ExamTime": 120, "ExerSortType": 1, "ScoringMethod": 1, "TotalScore": 150, "SimType": "历年真题", "ExamName": "成教专升本高等数学（一）模拟题五"}, "simId": 15682}