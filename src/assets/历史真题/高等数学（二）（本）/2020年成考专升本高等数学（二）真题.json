Score": 0, "wcId": 25}, {"a": "", "accuracyAmount": 0, "analyze": "", "b": "", "c": "", "catId": 0, "correct": false, "correctTimesAmount": 0, "d": "", "diffCoeff": 1, "e": "", "econtent": "", "exerId": 1940909, "exerType": "历年试题", "f": "", "freqCoeff": 1, "g": "", "h": "", "htmlTag": true, "jcontent": "<p style=\"margin:0cm;margin-bottom:.0001pt;text-align:justify;text-justify:inter-ideograph;font-size:10.5pt;font-family:等线\"><span><img width=\"553\" height=\"316\" src=\"http://ppt.beegoedu.com/ewebeditor_v2/uploadfile/20210227134715621001.png\"></span></p>", "keyType": "解答题", "matRef": "", "myCollectionId": 0, "newKeyType": 3, "optNum": 1, "pptId": 0, "prName": "2020年成考专升本高等数学（二）真题", "pracTimesAmount": 0, "questionType": 3, "reviewExerGroupRecId": 0, "rightKey": "", "rightRate": 0, "score": 10, "scoreLess": 0, "scoreRules": 0, "scoringMethod": 1, "simExamScore": 10, "source": "2020", "starCount": 0, "title": "求函数z=x<sup>2</sup>+2y<sup>4</sup>+4xy<sup>2</sup>-2x的极值", "topicType": "主观题", "ueId": 1940909, "umcId": 10671280, "userKey": "", "userKeyImg1": "", "userKeyImg2": "", "userKeyImg3": "", "userScore": 0, "wcId": 26}, {"a": "", "accuracyAmount": 0, "analyze": "y’=3x<sup>2</sup>-6x+2,y’’=6x-6,\n<br>令y’’=0,得x=1.\n<br>当x&gt;1时,y’’ &gt;0,故(1,+∞)为曲线的凹区间;\n<br>当x&lt;1时,y’’ &lt;0,故(-∞,1)为曲线的凸区间,\n<br>函数的拐点为(1,1)\n", "b": "", "c": "", "catId": 0, "correct": false, "correctTimesAmount": 0, "d": "", "diffCoeff": 1, "e": "", "econtent": "", "exerId": 1940910, "exerType": "历年试题", "f": "", "freqCoeff": 1, "g": "", "h": "", "htmlTag": true, "jcontent": "", "keyType": "解答题", "matRef": "", "myCollectionId": 0, "newKeyType": 3, "optNum": 1, "pptId": 0, "prName": "2020年成考专升本高等数学（二）真题", "pracTimesAmount": 0, "questionType": 3, "reviewExerGroupRecId": 0, "rightKey": "", "rightRate": 0, "score": 10, "scoreLess": 0, "scoreRules": 0, "scoringMethod": 1, "simExamScore": 10, "source": "2020", "starCount": 0, "title": "求曲线y=x<sup>3</sup>-3x<sup>2</sup>+2x+1的凹凸区间与拐点.", "topicType": "主观题", "ueId": 1940910, "umcId": 10671280, "userKey": "", "userKeyImg1": "", "userKeyImg2": "", "userKeyImg3": "", "userScore": 0, "wcId": 27}, {"a": "", "accuracyAmount": 0, "analyze": "（1）由概率的性质可知a+0.5+b=1,\n<br>又E(X)=0,得-1×a+0×0.5+2×b=0,\n<br>故有a=1/3,b=1/6\n<br>（2）E[X(X+1)]=E(X<sup>2</sup>+X)=E(X<sup>2</sup>)+E(X),\n<br>而E(X<sup>2</sup>)=D(X)+[E(X)] <sup>2</sup>\n<br>=1/3·(-1-0) <sup>2</sup>+1/2·(0-0) <sup>2</sup>+1/6·(2-0) <sup>2</sup>\n<br>=1\n<br>因此E[X(X+1)]=1+0=1\n", "b": "", "c": "", "catId": 0, "correct": false, "correctTimesAmount": 0, "d": "", "diffCoeff": 1, "e": "", "econtent": "", "exerId": 1940911, "exerType": "历年试题", "f": "", "freqCoeff": 1, "g": "", "h": "", "htmlTag": true, "jcontent": "", "keyType": "解答题", "matRef": "", "myCollectionId": 0, "newKeyType": 3, "optNum": 1, "pptId": 0, "prName": "2020年成考专升本高等数学（二）真题", "pracTimesAmount": 0, "questionType": 3, "reviewExerGroupRecId": 0, "rightKey": "", "rightRate": 0, "score": 10, "scoreLess": 0, "scoreRules": 0, "scoringMethod": 1, "simExamScore": 10, "source": "2020", "starCount": 0, "title": "已知离散型随机变量X的概率分布为\n<br><img src='http://ppt.beegoedu.com/CourseIMG/H012401/2021TKZT/B13.png' />\n<br>且E(X)=0\n<br>（1）求a,b\n<br>（2）求E[X(X+1)]\n", "topicType": "主观题", "ueId": 1940911, "umcId": 10671280, "userKey": "", "userKeyImg1": "", "userKeyImg2": "", "userKeyImg3": "", "userScore": 0, "wcId": 28}], "SimExamStore": {"ExerNum": 28, "CourseId": "H012401", "ExamTime": 150, "ExerSortType": 1, "ScoringMethod": 1, "TotalScore": 150, "SimType": "历年真题", "ExamName": "2020年成考专升本高等数学（二）真题"}, "simId": 15691}