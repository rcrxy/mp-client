{
   /* 全局设置 */
   "globalStyle": {
      "navigationBarTextStyle": "black",
      "enablePullDownRefresh": false,
      "navigationBarBackgroundColor": "#FFFFFF"
   },
   /* 按需引入第三方组件 */
   "easycom": {
      "autoscan": true,
      "custom": {
         "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue", // 匹配components目录内的vue文件
         "^u-(.*)": "uview-ui/components/u-$1/u-$1.vue"
      }
   },
   /* 路由 */
   "pages": [
      // /* 空白页 */ { "path": "pages/common/blank", "style": { "navigationStyle": "custom" } },

      /* 首页 HomeIndex */ { "path": "pages/home/home", "style": { "navigationStyle": "custom" } },
      /* 成绩查询 ScoreQuery */ {
         "path": "pages/home/tabs/ScoreQuery",
         "style": {
            "navigationBarTitleText": "成绩查询",
            "app-plus": {
               "titleNView": {
                  "buttons": [
                     {
                        "type": "share",
                        "float": "right"
                     }
                  ]
               }
            }
         }
      },
      /* 成考指南 Guide */ {
         "path": "pages/home/tabs/Guide",
         "style": {
            "navigationBarTitleText": "成考指南",
            "app-plus": {
               "titleNView": {
                  "buttons": [
                     {
                        "type": "share",
                        "float": "right"
                     }
                  ]
               }
            }
         }
      },
      /* 在线答疑 Answering */ { "path": "pages/home/tabs/Answering", "style": { "navigationBarTitleText": "在线答疑" } },
      /* 报名时间 Time */ {
         "path": "pages/home/process/Time",
         "style": {
            "navigationBarTitleText": "报名时间",
            "app-plus": {
               "titleNView": {
                  "buttons": [
                     {
                        "type": "share",
                        "float": "right"
                     }
                  ]
               }
            }
         }
      },
      /* 报名入口 Entrance */ {
         "path": "pages/home/process/Entrance",
         "style": {
            "navigationBarTitleText": "报名入口",
            "app-plus": {
               "titleNView": {
                  "buttons": [
                     {
                        "type": "share",
                        "float": "right"
                     }
                  ]
               }
            }
         }
      },
      /* 考试科目 ExamSubjects */ {
         "path": "pages/home/process/ExamSubjects",
         "style": {
            "navigationBarTitleText": "考试科目",
            "app-plus": {
               "titleNView": {
                  "buttons": [
                     {
                        "type": "share",
                        "float": "right"
                     }
                  ]
               }
            }
         }
      },
      /* 报考条件 Condition */ {
         "path": "pages/home/process/Condition",
         "style": {
            "navigationBarTitleText": "报考条件",
            "app-plus": {
               "titleNView": {
                  "buttons": [
                     {
                        "type": "share",
                        "float": "right"
                     }
                  ]
               }
            }
         }
      },
      /* 最新咨询 News */ {
         "path": "pages/home/News",
         "style": {
            "navigationBarTitleText": "成考咨询",
            "enablePullDownRefresh": false,
            "app-plus": {
               "titleNView": {
                  "buttons": [
                     {
                        "type": "share",
                        "float": "right"
                     }
                  ]
               }
            }
         }
      },
      /* 资讯列表 newsList */ {
         "path": "pages/home/newsList",
         "style": { "navigationBarTitleText": "成考咨询", "enablePullDownRefresh": true }
      },
      /* 院校专业 Specialized */ { "path": "pages/home/Specialized", "style": { "navigationBarTitleText": "院校专业" } },
      /* 专业详情 ProfessionalDetails */ { "path": "pages/home/Specialized/ProfessionalDetails", "style": { "navigationBarTitleText": "专业详情" } },

      /* 课程 project */ {
         "path": "pages/project/project",
         "style": {
            // "enablePullDownRefresh": true,
            "app-plus": {
               "titleNView": {
                  "titleText": "课程",
                  "titleAlign": "left",
                  "buttons": [
                     {
                        "type": "none",
                        "float": "right",
                        "text": ""
                     }
                  ]
               },
               "pullToRefresh": {}
            }
         }
      },
      /* 课程详情 ProjectIndex */ { "path": "pages/project/ProjectContent", "style": { "navigationStyle": "custom" } },
      /* 播放视频 PlayVideo */ { "path": "pages/project/PlayVideo", "style": { "navigationBarTitleText": "观看视频" } },

      /* 题库 practice */ { "path": "pages/practice/practice", "style": { "navigationStyle": "custom", "enablePullDownRefresh": true } },
      /* 题库内容 info */ { "path": "pages/practice/info", "style": { "navigationBarTitleText": "题库" } },
      /* 每日一练 EverDay */ { "path": "pages/practice/common/info/EverDay", "style": { "navigationBarTitleText": "每日一练" } },
      /* 模拟练习 mockExam */ { "path": "pages/practice/common/info/mockExam", "style": { "navigationBarTitleText": "模拟练习" } },
      /* 做题 WorkProblem */ { "path": "pages/practice/common/WorkProblem", "style": { "navigationBarTitleText": "模拟练习" } },
      /* 我的收藏(仅当前科目) */ { "path": "pages/practice/subjectCollection", "style": { "navigationBarTitleText": "我的收藏", "enablePullDownRefresh": true } },

      /* 我的 user */ { "path": "pages/user/user", "style": { "navigationStyle": "custom" } },
      /* 个人信息 Information */ { "path": "pages/user/Information", "style": { "navigationBarTitleText": "个人信息", "enablePullDownRefresh": true } },
      /* 通知消息 Notice */ { "path": "pages/user/Notice", "style": { "navigationBarTitleText": "系统通知" } },
      /* 修改信息 ChangeInfo*/ { "path": "pages/user/Information/ChangeInfo", "style": { "navigationBarTitleText": "修改信息" } },
      /* 我的地址 Address */ { "path": "pages/user/Information/Address", "style": { "navigationBarTitleText": "我的地址" } },
      /* 新增地址 AddAddress */ { "path": "pages/user/Information/AddAddress", "style": { "navigationBarTitleText": "新增地址" } },

      /* 我的订单 UserOrder */ { "path": "pages/user/UserOrder", "style": { "navigationBarTitleText": "我的订单" } },
      /* 我的收藏 UserCollection */ { "path": "pages/user/UserCollection", "style": { "navigationBarTitleText": "我的收藏" } },

      /* 软件设置 Setting */ { "path": "pages/user/Setting", "style": { "navigationBarTitleText": "软件设置" } },

      /* 意见反馈 Feedback */ { "path": "pages/user/common/Feedback", "style": { "navigationBarTitleText": "意见反馈" } },
      /* 关于我们 About */ { "path": "pages/user/common/About", "style": { "navigationBarTitleText": "关于我们" } },

      /* 登录 Login */ { "path": "pages/common/Login", "style": { "navigationStyle": "custom" } },

      // /* 专属客服 CustomerService */ { "path": "pages/user/CustomerService" },

      /* 用户协议 */ { "path": "pages/common/protocol", "style": { "navigationBarTitleText": "用户协议" } },
      /* 隐私政策 */ { "path": "pages/common/privacy", "style": { "navigationBarTitleText": "隐私政策" } }
   ],
   /* 导航栏 */ "tabBar": {
      "color": "#7A7E83",
      "selectedColor": "#3cc51f",
      "borderStyle": "white",
      "backgroundColor": "#ffffff",
      "list": [
         {
            "pagePath": "pages/home/home",
            "iconPath": "static/images/tabBar/home.png",
            "selectedIconPath": "static/images/tabBar/home_hr.png",
            "text": "首页"
         },
         {
            "pagePath": "pages/project/project",
            "iconPath": "static/images/tabBar/project.png",
            "selectedIconPath": "static/images/tabBar/project_hr.png",
            "text": "课程"
         },
         {
            "pagePath": "pages/practice/practice",
            "iconPath": "static/images/tabBar/practice.png",
            "selectedIconPath": "static/images/tabBar/practice_hr.png",
            "text": "题库"
         },
         {
            "pagePath": "pages/user/user",
            "iconPath": "static/images/tabBar/user.png",
            "selectedIconPath": "static/images/tabBar/user_hr.png",
            "text": "我的"
         }
      ]
   },
   "condition": {
      //模式配置，仅开发期间生效
      "current": 0, //当前激活的模式(list 的索引项)
      "list": [
         {
            "name": "", //模式名称
            "path": "", //启动页面，必选
            "query": "" //启动参数，在页面的onLoad函数里面得到
         }
      ]
   }
}
