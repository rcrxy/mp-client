      },
      /* 报考条件 Condition */ {
         "path": "pages/home/applyProcess/Condition",
         "style": {
            "navigationBarTitleText": "报考条件",
            "enablePullDownRefresh": false,
            "app-plus": {
               "titleNView": {
                  "buttons": [
                     {
                        "type": "share",
                        "float": "right"
                     }
                  ]
               }
            }
         }
      },
      /* 最新咨询 News */ {
         "path": "pages/home/News",
         "style": {
            "navigationBarTitleText": "成考咨询",
            "enablePullDownRefresh": true,
            "app-plus": {
               "titleNView": {
                  "buttons": [
                     {
                        "type": "share",
                        "float": "right"
                     }
                  ]
               }
            }
         }
      },
      /* 院校专业 Specialized */ {
         "path": "pages/home/Specialized",
         "style": {
            "navigationBarTitleText": "院校专业",
            "enablePullDownRefresh": false
         }
      },
      /* 专业详情 ProfessionalDetails */ {
         "path": "pages/home/Specialized/ProfessionalDetails",
         "style": {
            "navigationBarTitleText": "专业详情",
            "enablePullDownRefresh": false
         }
      },

      /* 课程 ProjectIndex */ {
         "path": "pages/project/ProjectIndex",
         "style": {
            "enablePullDownRefresh": false,
            "app-plus": {
               "titleNView": {
                  "titleText": "课程",
                  "titleAlign": "left",
                  "buttons": [
                     {
                        "type": "none",
                        "float": "right",
                        "text": ""
                     }
                  ]
               },
               "pullToRefresh": {}
            }
         }
      },
      /* 课程详情 ProjectIndex */ { "path": "pages/project/ProjectContent", "style": { "navigationStyle": "custom", "enablePullDownRefresh": false } },

      /* 题库 PracticeIndex */ { "path": "pages/practice/PracticeIndex", "style": { "navigationBarTitleText": "题库", "enablePullDownRefresh": false } },
