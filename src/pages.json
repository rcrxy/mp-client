{
   /* 全局设置 */
   "globalStyle": {
      "navigationBarTextStyle": "black",
      "enablePullDownRefresh": false,
      "navigationBarBackgroundColor": "#FFFFFF"
   },
   /* 按需引入第三方组件 */
   "easycom": {
      "autoscan": true,
      "custom": {
         "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue", // 匹配components目录内的vue文件
         "^u-(.*)": "uview-ui/components/u-$1/u-$1.vue"
      }
   },
   /* 路由 */
   "pages": [
      /* 空白页   */ { "path": "pages/common/blank", "style": { "navigationStyle": "custom" } },

      /* 首页     */ { "path": "pages/home/home", "style": { "navigationStyle": "custom" } },
      /* 成绩查询 */ { "path": "pages/home/tabs/ScoreQuery", "style": { "navigationBarTitleText": "成绩查询" } },
      /* 成考指南 */ { "path": "pages/home/tabs/Guide", "style": { "navigationBarTitleText": "成考指南" } },
      /* 报名时间 */ { "path": "pages/home/process/Time", "style": { "navigationBarTitleText": "报名时间" } },
      /* 报名入口 */ { "path": "pages/home/process/Entrance", "style": { "navigationBarTitleText": "报名入口" } },
      /* 考试科目 */ { "path": "pages/home/process/ExamSubjects", "style": { "navigationBarTitleText": "考试科目" } },
      /* 报考条件 */ { "path": "pages/home/process/Condition", "style": { "navigationBarTitleText": "报考条件" } },
      /* 最新咨询 */ { "path": "pages/home/News", "style": { "navigationBarTitleText": "成考咨询", "enablePullDownRefresh": false } },
      /* 资讯列表 */ { "path": "pages/home/newsList", "style": { "navigationBarTitleText": "成考咨询", "enablePullDownRefresh": true } },
      /* 院校专业 */ { "path": "pages/home/Specialized", "style": { "navigationBarTitleText": "院校专业" } },
      /* 专业详情 */ { "path": "pages/home/Specialized/ProfessionalDetails", "style": { "navigationBarTitleText": "专业详情" } },

      /* 课程     */ { "path": "pages/project/project", "style": { "navigationBarTitleText": "课程", "enablePullDownRefresh": true } },
      /* 课程详情 */ { "path": "pages/project/ProjectContent", "style": { "navigationStyle": "custom" } },
      /* 播放视频 */ { "path": "pages/project/PlayVideo", "style": { "navigationBarTitleText": "观看视频" } },

      /* 题库     */ {
         "path": "pages/practice/practice",
         "style": {
            "navigationStyle": "custom",
            "app-plus": {
               "pullToRefresh": {
                  "support": true,
                  "offset": "115px"
               }
            }
         }
      },
      /* 题库内容 */ { "path": "pages/practice/info", "style": { "navigationBarTitleText": "题库" } },
      /* 模拟练习 */ { "path": "pages/practice/common/info/mockExam", "style": { "navigationBarTitleText": "模拟练习" } },
      /* 做题     */ { "path": "pages/practice/common/WorkProblem", "style": { "navigationStyle": "custom" } },
      /* 我的收藏 */ { "path": "pages/practice/subjectCollection", "style": { "navigationBarTitleText": "我的收藏", "enablePullDownRefresh": true } },

      /* 我的     */ { "path": "pages/user/user", "style": { "navigationStyle": "custom" } },
      /* 账户设置 */ { "path": "pages/user/Information", "style": { "navigationBarTitleText": "账户设置", "enablePullDownRefresh": true } },
      /* 通知消息 */ { "path": "pages/user/Notice", "style": { "navigationBarTitleText": "通知消息" } },
      /* 修改信息 */ { "path": "pages/user/Information/ChangeInfo", "style": { "navigationBarTitleText": "修改信息" } },
      /* 修改密码 */ { "path": "pages/user/Information/changePassword", "style": { "navigationBarTitleText": "修改密码" } },
      /* 我的地址 */ { "path": "pages/user/Information/Address", "style": { "navigationBarTitleText": "我的地址" } },
      /* 新增地址 */ { "path": "pages/user/Information/AddAddress", "style": { "navigationBarTitleText": "新增地址" } },

      /* 我的订单 */ { "path": "pages/user/UserOrder", "style": { "navigationBarTitleText": "我的订单" } },
      /* 我的收藏 */ { "path": "pages/user/UserCollection", "style": { "navigationBarTitleText": "我的收藏", "enablePullDownRefresh": true } },

      /* 软件设置 */ { "path": "pages/user/Setting", "style": { "navigationBarTitleText": "软件设置" } },

      /* 意见反馈 */ { "path": "pages/user/common/Feedback", "style": { "navigationBarTitleText": "意见反馈" } },
      /* 关于我们 */ { "path": "pages/user/common/About", "style": { "navigationBarTitleText": "关于我们" } },

      /* 登录     */ { "path": "pages/common/Login", "style": { "navigationStyle": "custom" } },

      /* 专属客服 */ { "path": "pages/common/CustomerService", "style": { "navigationBarTitleText": "专属客服" } },

      /* 用户协议 */ { "path": "pages/common/protocol", "style": { "navigationBarTitleText": "用户协议" } },
      /* 隐私政策 */ { "path": "pages/common/privacy", "style": { "navigationBarTitleText": "隐私政策" } }
   ],
   /* 导航栏 */ "tabBar": {
      "color": "#7A7E83",
      "selectedColor": "#3cc51f",
      "borderStyle": "white",
      "backgroundColor": "#ffffff",
      "list": [
         {
            "pagePath": "pages/home/home",
            "iconPath": "static/images/tabBar/home.png",
            "selectedIconPath": "static/images/tabBar/home_hr.png",
            "text": "首页"
         },
         {
            "pagePath": "pages/project/project",
            "iconPath": "static/images/tabBar/project.png",
            "selectedIconPath": "static/images/tabBar/project_hr.png",
            "text": "课程"
         },
         {
            "pagePath": "pages/practice/practice",
            "iconPath": "static/images/tabBar/practice.png",
            "selectedIconPath": "static/images/tabBar/practice_hr.png",
            "text": "题库"
         },
         {
            "pagePath": "pages/user/user",
            "iconPath": "static/images/tabBar/user.png",
            "selectedIconPath": "static/images/tabBar/user_hr.png",
            "text": "我的"
         }
      ]
   },
   "condition": {
      //模式配置，仅开发期间生效
      "current": 0, //当前激活的模式(list 的索引项)
      "list": [
         {
            "name": "", //模式名称
            "path": "", //启动页面，必选
            "query": "" //启动参数，在页面的onLoad函数里面得到
         }
      ]
   }
}
