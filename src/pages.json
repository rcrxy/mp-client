{
   /* 全局设置 */
   "globalStyle": {
      "navigationBarTextStyle": "black",
      "enablePullDownRefresh": true,
      "navigationBarBackgroundColor": "#FFFFFF"
   },
   /* 引入uni-ui */
   "easycom": {
      "autoscan": true,
      "custom": {
         "^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue", // 匹配components目录内的vue文件
         "^u-(.*)": "uview-ui/components/u-$1/u-$1.vue"
      }
   },
   /* 路由 */
   "pages": [
      /* 首页 HomeIndex */ { "path": "pages/home/HomeIndex", "style": { "navigationStyle": "custom" } },
      /* 成绩查询 ScoreQuery */ {
         "path": "pages/home/tabs/ScoreQuery",
         "style": {
            "navigationBarTitleText": "成绩查询",
            "enablePullDownRefresh": false,
            "app-plus": {
               "titleNView": {
                  "buttons": [
                     {
                        "type": "share",
                        "float": "right"
                     }
                  ]
               }
            }
         }
      },
      /* 成考指南 Guide */ {
         "path": "pages/home/tabs/Guide",
         "style": {
            "navigationBarTitleText": "成考指南",
            "enablePullDownRefresh": false,
            "app-plus": {
               "titleNView": {
                  "buttons": [
                     {
                        "type": "share",
                        "float": "right"
                     }
                  ]
               }
            }
         }
      },
      /* 在线答疑 Answering */ { "path": "pages/home/tabs/Answering", "style": { "enablePullDownRefresh": false } },
      /* 报名时间 Time */ {
         "path": "pages/home/applyProcess/Time",
         "style": {
            "navigationBarTitleText": "报名时间",
            "enablePullDownRefresh": false,
            "app-plus": {
               "titleNView": {
                  "buttons": [
                     {
                        "type": "share",
                        "float": "right"
                     }
                  ]
               }
            }
         }
      },
      /* 报名入口 Entrance */ {
         "path": "pages/home/applyProcess/Entrance",
         "style": {
            "navigationBarTitleText": "报名入口",
            "enablePullDownRefresh": true,
            "app-plus": {
               "titleNView": {
                  "buttons": [
                     {
                        "type": "share",
                        "float": "right"
                     }
                  ]
               }
            }
         }
      },
      /* 考试科目 ExamSubjects */ {
         "path": "pages/home/applyProcess/ExamSubjects",
         "style": {
            "navigationBarTitleText": "考试科目",
            "enablePullDownRefresh": false,
            "app-plus": {
               "titleNView": {
                  "buttons": [
                     {
                        "type": "share",
                        "float": "right"
                     }
                  ]
               }
            }
