      /* 每日一练 EverDay */ { "path": "pages/practice/common/info/EverDay", "style": { "navigationBarTitleText": "每日一练", "enablePullDownRefresh": false } },
      /* 模拟练习 mockExam */ { "path": "pages/practice/common/info/mockExam", "style": { "navigationBarTitleText": "模拟练习", "enablePullDownRefresh": false } },

      /* 我的 UserIndex */ { "path": "pages/user/UserIndex", "style": { "navigationStyle": "custom", "enablePullDownRefresh": false } },
      /* 个人信息 Information */ { "path": "pages/user/Information", "style": { "navigationBarTitleText": "个人信息" } },
      /* 通知消息 Notice */ { "path": "pages/user/Notice", "style": { "navigationBarTitleText": "系统通知" } },
      /* 修改信息 ChangeInfo*/ { "path": "pages/user/Information/ChangeInfo", "style": { "navigationBarTitleText": "个人信息", "enablePullDownRefresh": false } },
      /* 我的地址 ChangeSign */ { "path": "pages/user/Information/ChangeAddress", "style": { "navigationBarTitleText": "我的地址", "enablePullDownRefresh": false } },
      /* 新增地址 AddAddress */ { "path": "pages/user/Information/AddAddress", "style": { "navigationBarTitleText": "新增地址", "enablePullDownRefresh": false } },

      /* 我的订单 UserOrder */ { "path": "pages/user/UserOrder", "style": { "navigationBarTitleText": "我的订单" } },
      /* 我的收藏 UserCollection */ { "path": "pages/user/UserCollection", "style": { "navigationBarTitleText": "我的收藏" } },

      /* 软件设置 Setting */ { "path": "pages/user/Setting", "style": { "navigationBarTitleText": "软件设置", "enablePullDownRefresh": false } },

      /* 意见反馈 Feedback */ { "path": "pages/user/common/Feedback", "style": { "navigationBarTitleText": "意见反馈", "enablePullDownRefresh": false } },
      /* 关于我们 About */ { "path": "pages/user/common/About", "style": { "navigationBarTitleText": "关于我们", "enablePullDownRefresh": false } },

      /* 登录 Login */ { "path": "pages/common/Login", "style": { "navigationStyle": "custom", "enablePullDownRefresh": false } }

      // /* 专属客服 CustomerService */ { "path": "pages/user/CustomerService" },
   ],
   /* 导航栏 */
   "tabBar": {
      "color": "#7A7E83",
      "selectedColor": "#3cc51f",
      "borderStyle": "grey",
      "backgroundColor": "#ffffff",
      "list": [
         {
            "pagePath": "pages/home/HomeIndex",
            "iconPath": "static/images/tabBar/home.png",
            "selectedIconPath": "static/images/tabBar/home_hr.png",
            "text": "首页"
         },
         {
            "pagePath": "pages/project/ProjectIndex",
            "iconPath": "static/images/tabBar/project.png",
            "selectedIconPath": "static/images/tabBar/project_hr.png",
            "text": "课程"
         },
         {
            "pagePath": "pages/practice/PracticeIndex",
            "iconPath": "static/images/tabBar/practice.png",
            "selectedIconPath": "static/images/tabBar/practice_hr.png",
            "text": "题库"
         },
         {
            "pagePath": "pages/user/UserIndex",
            "iconPath": "static/images/tabBar/user.png",
            "selectedIconPath": "static/images/tabBar/user_hr.png",
            "text": "我的"
         }
      ]
   },
   "condition": {
      //模式配置，仅开发期间生效
      "current": 0, //当前激活的模式(list 的索引项)
      "list": [
         {
            "name": "", //模式名称
            "path": "pages/practice/PracticeIndex", //启动页面，必选
            "query": "" //启动参数，在页面的onLoad函数里面得到
         }
      ]
   }
}
